# Copy to /etc/jarvis/service.env, owned root:jarvis and mode 0640.
JARVIS_PUBLIC_URL=https://accounts.your-domain.example
JARVIS_SERVER_DB=/var/lib/jarvis/accounts.sqlite3
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
OPEN_METEO_API_KEY=
JARVIS_COMMERCIAL_WEATHER=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
