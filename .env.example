# Free testing mode (default)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=put_your_openrouter_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=https://github.com/Adib0105/JARVIS-AI-OMEGA
OPENROUTER_APP_TITLE=JARVIS AI OMEGA

# Optional paid OpenAI mode for later: set AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
REASONING_EFFORT=xhigh

JARVIS_NAME=JARVIS OMEGA
CREATOR_NAME=Adib Azam
USER_NAME=Adib
LANGUAGE_MODE=auto

# Hosted web search + Code Interpreter are OpenAI-provider features in this project.
# OpenRouter free mode keeps these off automatically even if these values are true.
ENABLE_WEB_SEARCH=true
ENABLE_CODE_INTERPRETER=true
ENABLE_LOCAL_TOOLS=true
REQUIRE_LOCAL_APPROVAL=true

# You type; JARVIS speaks its reply. No microphone input.
ENABLE_VOICE_OUTPUT=true
VOICE_RATE=185
VOICE_VOLUME=1.0

MAX_TOOL_ROUNDS=10
HISTORY_MESSAGES=24
# Optional; semicolon-separated. Blank = Desktop;Documents;Downloads;project folder
ALLOWED_FILE_ROOTS=
