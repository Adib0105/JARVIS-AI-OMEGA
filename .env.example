# JARVIS AI OMEGA V5
# Free testing mode (default)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=put_your_openrouter_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=https://github.com/Adib0105/JARVIS-AI-OMEGA
OPENROUTER_APP_TITLE=JARVIS AI OMEGA V5

# Optional paid OpenAI mode for later: set AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
REASONING_EFFORT=xhigh

JARVIS_NAME=JARVIS OMEGA
CREATOR_NAME=Adib Azam
USER_NAME=Adib
LANGUAGE_MODE=auto

# Web/tools
ENABLE_PUBLIC_WEB_TOOLS=true
ENABLE_WEB_SEARCH=true
ENABLE_CODE_INTERPRETER=true
ENABLE_LOCAL_TOOLS=true
REQUIRE_LOCAL_APPROVAL=true

# Typed input + spoken output. No microphone input.
ENABLE_VOICE_OUTPUT=true
VOICE_ENGINE=edge
VOICE_HINDI=hi-IN-MadhurNeural
VOICE_HINGLISH=en-IN-PrabhatNeural
VOICE_ENGLISH=en-IN-PrabhatNeural
EDGE_VOICE_RATE=-2%
EDGE_VOICE_VOLUME=+5%
EDGE_VOICE_PITCH=-18Hz
VOICE_RATE=175
VOICE_VOLUME=1.0

# Reliability
AI_TIMEOUT_SECONDS=60
VISION_TIMEOUT_SECONDS=75
API_MAX_RETRIES=2
MAX_TOOL_ROUNDS=10
HISTORY_MESSAGES=30

# V5 image upload / multimodal settings
MAX_IMAGE_ATTACHMENTS=4
MAX_IMAGE_MB=12
IMAGE_MAX_DIMENSION=1600
IMAGE_JPEG_QUALITY=82

# Storage
JARVIS_EXPORT_DIR=
# Optional; semicolon-separated. Blank = Desktop;Documents;Downloads;project folder
ALLOWED_FILE_ROOTS=
