# JARVIS AI OMEGA 8.x DEVELOPMENT / RELEASE-CANDIDATE TEMPLATE
# Free testing mode (default)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=put_your_openrouter_key_here
OPENROUTER_MODEL=openrouter/free
# Stay on OpenRouter's live free router instead of hard-coding a free model that may disappear.
OPENROUTER_STABLE_TEXT_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=https://github.com/Adib0105/JARVIS-AI-OMEGA
OPENROUTER_APP_TITLE=JARVIS AI OMEGA

# Optional OpenAI mode: set AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
REASONING_EFFORT=xhigh

# Model routing. Blank route models reuse the primary configured model.
MODEL_ROUTING=auto
FAST_MODEL=
SMART_MODEL=
VISION_MODEL=

# Optional local OpenAI-compatible fallback. Disabled until deliberately configured.
ENABLE_LOCAL_FALLBACK=false
LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_AI_MODEL=
LOCAL_AI_API_KEY=local
LOCAL_MODEL_PROVIDER=openai-compatible

# Controlled self-development.
SELF_DEVELOPMENT_ENABLED=true
OFFLINE_DEVELOPMENT_ENABLED=false
AUTO_TEST_ENABLED=true
AUTO_ROLLBACK_ENABLED=false
PRODUCTION_SELF_MODIFICATION=false
REQUIRE_APPROVAL_FOR_PRODUCTION=true
MAX_SELF_REPAIR_ATTEMPTS=3
MAX_FILES_CHANGED=20
MAX_LINES_CHANGED=1200
MAX_BUILD_TIME=300
MAX_TEST_TIME=300
MAX_CPU_USAGE=80
MAX_MEMORY_USAGE=80
SELF_EVALUATION_INTERVAL=0

EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

JARVIS_NAME=JARVIS OMEGA
CREATOR_NAME=Adib Azam
USER_NAME=Adib
LANGUAGE_MODE=auto

ENABLE_PUBLIC_WEB_TOOLS=true
ENABLE_WEB_SEARCH=true
ENABLE_CODE_INTERPRETER=true
ENABLE_LOCAL_TOOLS=true
REQUIRE_LOCAL_APPROVAL=true
ENABLE_DESKTOP_AUTOMATION=true
ENABLE_DOCUMENT_INTELLIGENCE=true
ENABLE_CODING_TOOLS=true
TRUSTED_LOCAL_MODE=true

PERMISSION_SYSTEM_READ=allow
PERMISSION_MEMORY_READ=allow
PERMISSION_MEMORY_WRITE=allow
PERMISSION_FILE_READ=allow
PERMISSION_FILE_WRITE=ask
PERMISSION_SCREEN_READ=ask
PERMISSION_SCREEN_CONTROL=ask
PERMISSION_BROWSER_READ=allow
PERMISSION_BROWSER_CONTROL=ask
PERMISSION_KEYBOARD_CONTROL=ask
PERMISSION_MOUSE_CONTROL=ask
PERMISSION_CODE_READ=allow
PERMISSION_CODE_WRITE=ask
PERMISSION_CODE_TEST=ask
PERMISSION_EMAIL_READ=allow
PERMISSION_EMAIL_SEND=always_ask
PERMISSION_CALENDAR_READ=allow
PERMISSION_CALENDAR_WRITE=always_ask
PERMISSION_WEB_READ=allow
PERMISSION_APP_CONTROL=ask
PERMISSION_DOCUMENT_READ=ask
PERMISSION_GIT_READ=allow
PERMISSION_ACCOUNT_CONFIG_READ=ask

ENABLE_GOOGLE_WORKSPACE=false
GOOGLE_OAUTH_CLIENT_FILE=
GOOGLE_TOKEN_FILE=

# Voice profile: emotional Indian female neural voice with offline fallback.
ENABLE_VOICE_OUTPUT=true
VOICE_ENGINE=edge
VOICE_PROFILE=indian-female-emotional
VOICE_EMOTION_ENABLED=true
VOICE_STREAMING_ENABLED=true
VOICE_BARGE_IN=true
# Keep normal replies in one neural synthesis/playback process to avoid multi-second gaps.
VOICE_CHUNK_CHARS=5000
VOICE_HINDI=hi-IN-SwaraNeural
VOICE_HINGLISH=en-IN-NeerjaNeural
VOICE_ENGLISH=en-IN-NeerjaNeural
VOICE_FALLBACK=en-IN-PrabhatNeural
EDGE_VOICE_RATE=-1%
EDGE_VOICE_VOLUME=+0%
EDGE_VOICE_PITCH=+0Hz
TTS_TIMEOUT_SECONDS=180
OFFLINE_TTS_TIMEOUT_SECONDS=90
VOICE_RATE=170
VOICE_VOLUME=1.0

ENABLE_MIC_INPUT=true
ENABLE_WAKE_WORD=false
WAKE_WORD=hey jarvis
SPEECH_LANGUAGE=auto
MIC_RECORD_SECONDS=6
WAKE_CHUNK_SECONDS=3.5
VOICE_CONTINUOUS_SECONDS=18

AI_TIMEOUT_SECONDS=60
VISION_TIMEOUT_SECONDS=75
MISSION_TIMEOUT_SECONDS=300
API_MAX_RETRIES=2
MAX_TOOL_ROUNDS=12
HISTORY_MESSAGES=36
MISSION_MAX_STEPS=5
AUTO_SUMMARIZE=false
SUMMARIZE_AFTER_MESSAGES=60

MAX_IMAGE_ATTACHMENTS=4
MAX_IMAGE_MB=12
IMAGE_MAX_DIMENSION=1600
IMAGE_JPEG_QUALITY=82

SYSTEM_REFRESH_MS=1200
REMINDER_POLL_SECONDS=5
JARVIS_LOG_LEVEL=INFO

JARVIS_EXPORT_DIR=
ALLOWED_FILE_ROOTS=
